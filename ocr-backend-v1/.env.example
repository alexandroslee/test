VCP_CORS_ORIGINS=https://alexandroslee.github.io

APIOCR_API_KEY=
APIOCR_MAX_UPLOAD_MB=10
APIOCR_USE_GPU=false
APIOCR_MIN_CONFIDENCE=0.3
APIOCR_OCR_BACKEND=easyocr
APIOCR_EASYOCR_LANGS=ch_tra,en
APIOCR_UPSCALE_MIN_SIDE=1000
APIOCR_DESKEW=true
APIOCR_ENHANCE_CONTRAST=false
APIOCR_CLAHE_CLIP=2.0
APIOCR_BRIGHTNESS=1.1
APIOCR_CONTRAST=1.2

APIOCR_VLM_BACKEND=cloud
APIOCR_VLM_ENABLED=true
APIOCR_VLM_MODEL=
APIOCR_TEXT_LLM_MODEL=
APIOCR_VLM_TIMEOUT=60
APIOCR_CLOUD_API_URL=
APIOCR_CLOUD_API_KEY=

APIOCR_LOCAL_VLM_ENABLED=true
APIOCR_LOCAL_VLM_URL=http://127.0.0.1:8001/v1
APIOCR_LOCAL_VLM_MODEL=gemma-31b
APIOCR_LOCAL_VLM_TIMEOUT=120
